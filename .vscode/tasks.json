{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ローカル: プレビューサーバー (8765)",
      "type": "shell",
      "command": "python3 -m http.server 8765 --bind 127.0.0.1",
      "isBackground": true,
      "problemMatcher": {
        "owner": "http-server",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
